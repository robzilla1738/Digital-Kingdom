{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-kingdom.dev/schemas/agent/change-assessment.v2.schema.json",
  "title": "dk.change_assessment.v2 — pre-change assessment",
  "description": "v2 removes the v1 field assessment_complete. Target resolution and evidence sufficiency are reported separately; only favorable=true postures are favorable.",
  "type": "object",
  "required": ["schema", "posture", "posture_meaning", "favorable", "target_resolution", "evidence_sufficiency", "targets", "unresolved", "blocking_findings", "recommendations"],
  "not": { "required": ["assessment_complete"] },
  "properties": {
    "schema": { "const": "dk.change_assessment.v2" },
    "posture": { "enum": ["hold", "proceed_with_care", "insufficient_context", "not_assessed", "no_recorded_concerns"] },
    "favorable": { "type": "boolean" },
    "target_resolution": { "type": "object", "required": ["complete", "requested", "resolved", "unresolved"], "properties": { "complete": { "type": "boolean" } } },
    "evidence_sufficiency": {
      "type": "object", "required": ["sufficient", "insufficient_targets"],
      "properties": {
        "sufficient": { "type": "boolean" },
        "insufficient_targets": { "type": "array", "items": { "type": "object", "required": ["asset_id", "sufficient", "reasons"], "properties": { "reasons": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["source_id", "state", "detail"], "properties": { "state": { "enum": ["stale", "offline", "not_assessed", "unobserved"] } } } } } } }
      }
    },
    "targets": { "type": "array", "items": { "type": "object", "required": ["asset", "direct_findings", "coverage", "evidence_sufficient"] } }
  },
  "allOf": [
    { "if": { "properties": { "favorable": { "const": true } } }, "then": { "properties": { "target_resolution": { "properties": { "complete": { "const": true } } }, "evidence_sufficiency": { "properties": { "sufficient": { "const": true } } } } } }
  ]
}
