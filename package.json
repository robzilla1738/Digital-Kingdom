{
  "name": "digital-kingdom",
  "private": true,
  "version": "0.3.2",
  "description": "Self-hosted security evidence console rendered as a navigable castle, with an MCP interface for AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dk/server --filter @dk/web dev",
    "dev:web": "pnpm --filter @dk/web dev",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "build": "pnpm --filter @dk/web build",
    "start": "tsx apps/server/src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:fixtures": "tsx scripts/validate-fixtures.ts",
    "check": "pnpm typecheck && pnpm test && pnpm validate:fixtures",
    "generate:validators": "pnpm --filter @dk/contracts generate:validators",
    "mcp": "tsx apps/mcp/src/main.ts",
    "fixtures:demo": "tsx scripts/build-demo-fixture.ts",
    "castle:manifest": "tsx scripts/update-castle-manifest.ts",
    "pilot": "playwright test",
    "diagnose:tombstones": "tsx scripts/diagnose-legacy-tombstones.ts",
    "eval:gen": "tsx eval/scripts/gen.ts",
    "eval:smoke": "tsx eval/scripts/smoke-cases.ts",
    "eval:run": "tsx eval/src/run.ts",
    "eval:report": "tsx eval/scripts/report.ts",
    "pilot:redesign": "pnpm build && pnpm build:redesign-fixtures && DK_RED_OFFLINE_DIST=artifacts/redesign/offline-dist playwright test --config=playwright.redesign.config.ts",
    "build:redesign-fixtures": "VITE_DK_STATIC_DEMO=1 pnpm --filter @dk/web exec vite build --outDir ../../artifacts/redesign/offline-dist --emptyOutDir",
    "quickstart": "tsx examples/reference-app/src/quickstart.ts",
    "world": "tsx examples/reference-app/src/world/cli.ts",
    "admin:recover": "tsx scripts/recover-admin.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/backup.ts --restore",
    "soak": "tsx scripts/soak.ts",
    "scenarios": "tsx scripts/run-scenarios.ts",
    "release:manifest": "tsx scripts/release-manifest.ts",
    "release:verify": "tsx scripts/release-manifest.ts --verify",
    "deps:inventory": "tsx scripts/dependency-inventory.ts",
    "extension:pin": "tsx scripts/pin-extension.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "axe-core": "4.10.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "~3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
