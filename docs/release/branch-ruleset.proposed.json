{
 "_note": "PROPOSED for owner approval (roadmap R10.5). Not applied by automation. Apply in Settings -> Rules -> Rulesets -> Import.",
 "name": "main protection (proposed)",
 "target": "branch",
 "enforcement": "active",
 "conditions": { "ref_name": { "include": ["refs/heads/main"], "exclude": [] } },
 "rules": [
  { "type": "deletion" },
  { "type": "non_fast_forward" },
  { "type": "required_linear_history" },
  { "type": "pull_request", "parameters": { "required_approving_review_count": 0, "dismiss_stale_reviews_on_push": true, "require_last_push_approval": false, "required_review_thread_resolution": true, "require_code_owner_review": false } },
  { "type": "required_status_checks", "parameters": { "strict_required_status_checks_policy": true, "required_status_checks": [{ "context": "check" }, { "context": "browser-pilot" }] } }
 ]
}
