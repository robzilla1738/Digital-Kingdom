{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dk:local-phase:investigation-contract:proposed:v1",
  "title": "Proposed investigation-contract contract \u2014 not an existing repository API",
  "type": "object",
  "properties": {
    "schema": {
      "const": "dk.local.investigation_contract.proposed.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "scope": {
      "type": "object",
      "properties": {
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 1,
          "maxItems": 200
        },
        "after": {
          "type": "string",
          "format": "date-time"
        },
        "before": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "asset_ids",
        "after",
        "before"
      ],
      "additionalProperties": false
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "status": {
            "enum": [
              "not_started",
              "running",
              "satisfied",
              "partial",
              "unavailable",
              "inapplicable_with_reason",
              "failed"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "maxItems": 200
          },
          "query_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "maxItems": 200
          },
          "reason": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "question",
          "status",
          "evidence_refs",
          "query_refs",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "readiness": {
      "enum": [
        "not_started",
        "collecting",
        "bounded_answer_ready",
        "unresolved_answer_ready",
        "blocked"
      ]
    },
    "snapshot_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 200
    },
    "private_truth_access": {
      "const": false
    }
  },
  "required": [
    "schema",
    "id",
    "case_id",
    "project_id",
    "run_id",
    "revision",
    "question",
    "scope",
    "obligations",
    "readiness",
    "snapshot_refs",
    "private_truth_access"
  ],
  "additionalProperties": false
}
