 "decisions": [
  {
   "id": "D-LP00-1",
   "date": "2026-10-23",
   "decision": "Phase package copied into docs/phases/local-intelligence/package and fingerprinted, so the spec cannot drift silently and CI can read contracts/fixtures."
  },
  {
   "id": "D-LP00-2",
   "date": "2026-10-23",
   "decision": "Runtime policy is computed from actual server configuration and exposed in /api/capabilities (runtime_policy); it authorizes nothing."
  },
  {
   "id": "D-LP00-3",
   "date": "2026-10-23",
   "decision": "eval/src/v2/run.ts BudgetLedger(5) is historical; no phase model run may use it. Any LP24+ run needs a new ledger capped by the phase budget ($3.00 total)."
  },
  {
   "id": "D-LP01-1",
   "date": "2026-10-23",
   "decision": "Evaluator decisions carry evaluator=dk.aws_policy_eval.v2; access_paths schema id unchanged because the change is additive fields plus corrected classification, recorded here and in the receipt."
  },
  {
   "id": "D-LP01-2",
   "date": "2026-10-23",
   "decision": "An omitted resource policy key is now unresolved (null = none). An omitted permission boundary keeps v1 meaning 'none'; exporters must send 'unknown' when unreadable (declared limit)."
  },
  {
   "id": "D-LP02-1",
   "date": "2026-10-23",
   "decision": "Recipe run contract bumped to dk.recipe_run.v2 and every recipe to @2 (meaning changed: obligations, kinds, paging). v1 recipes are retired, not kept runnable, because v1 reproduces the LP02 defects; stored case text that quotes @1 is unchanged."
  },
  {
   "id": "D-LP02-2",
   "date": "2026-10-23",
   "decision": "Recipe budget unit is one search page or one coverage question (max 12). Running out produces partial/not_run obligations and outstanding continuations, never an implied answer."
  },
  {
   "id": "D-LP03-1",
   "date": "2026-10-23",
   "decision": "Run provenance is project-level in projects.meta.local_run (no DB migration), validated against dk.local.run_provenance.v1, orthogonal to dataset_kind. Reference pack uses dataset_kind live + local_run."
  },
  {
   "id": "D-LP03-2",
   "date": "2026-10-23",
   "decision": "Adopted world-plan and verification-receipt proposals as dk.local.*.v1 (proposal ids rejected until migrated). investigation-contract, conclusion and repair-plan proposals deferred to the packages that implement them."
  },
  {
   "id": "D-LP03-3",
   "date": "2026-10-23",
   "decision": "Surface registry support stays the product-wide ceiling; per-asset capability tier is derived only from scoped receipts and capped by the ceiling. externally_verified receipts are rejected while EXT01 is deferred."
  }
 ],
