+  const unobserved = gapAssets.filter((a) => vm.assetStatus.get(a.id)?.coverage === "unobserved");
+  const partial = gapAssets.filter((a) => vm.assetStatus.get(a.id)?.coverage === "partial");
+  return <section className="workspace-page coverage-workspace" aria-label="Coverage workspace">
+    <div className="workspace-heading"><div><div className="eyebrow">VISIBILITY, NOT A SECURITY VERDICT</div><h1>Know what you can see.</h1><p className="workspace-lede">Reporting sources and missing visibility, kept separate from findings and browser connectivity.</p></div><button className="btn" onClick={() => dispatch({ type: "workspace", workspace: "integrations" })}>View setup guidance</button></div>
+    <div className="summary-strip" role="group" aria-label="Coverage summary"><div className="summary-item"><strong>{unavailable.length}</strong><span>sources not reporting</span></div><div className="summary-item"><strong>{gapAssets.length}</strong><span>assets with visibility gaps</span></div><div className="summary-item"><strong>{partial.length}</strong><span>assets with partial visibility</span></div><div className="summary-item"><strong>{unobserved.length}</strong><span>unobserved assets</span></div></div>
+    <div className="scope-note"><strong>Current coverage as of {fmtDateTime(vm.coverageAsOf)}.</strong> Historical coverage is not assessed. {ui.playhead ? "Replay does not reconstruct historical source administration. " : ""}A reporting source is not proof of complete detection. A missing assessment remains unknown.</div>
+    <Tabs label="Coverage views" value={tab} onChange={setTab} panelId="coverage-panel" options={[{ value: "sources", label: "Sources" }, { value: "assets", label: "Assets with gaps" }]} />
