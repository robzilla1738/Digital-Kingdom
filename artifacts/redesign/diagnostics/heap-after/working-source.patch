= undefined ? `${source.stale_after_seconds}s freshness threshold` : "No freshness threshold supplied"}</span></td><td>{source.disabled ? "Administratively disabled. Stored events do not establish current reporting." : coverage?.note ?? (coverage?.state === "healthy" ? "Reporting according to current freshness checks; not proof of complete detection." : "A current reporting assessment is unavailable.")}</td></tr>; })}</tbody></table></div> : !gapAssets.length ? <div className="empty"><Icon name="layers" size={28} /><h3>No visibility gaps recorded in this snapshot.</h3><p>This reflects configured source reporting, not complete detection or proof of safety.</p></div> : <div className="table-scroll" tabIndex={0} role="region" aria-label="Assets with visibility gaps"><table className="record-table"><thead><tr><th scope="col">Asset</th><th scope="col">Visibility</th><th scope="col">Reporting sources</th><th scope="col">Explanation</th></tr></thead><tbody>{gapAssets.map((asset) => { const status = vm.assetStatus.get(asset.id)!; return <tr key={asset.id} data-asset-id={asset.id} data-coverage={status.coverage}><td className="record-title"><button className="link" onClick={() => dispatch({ type: "select", selection: { kind: "asset", id: asset.id } })}>{asset.name}</button><small>{KIND_LABEL[asset.kind]} · {asset.environment}</small></td><td><CoverageChip state={status.coverage} /></td><td>{status.reportingSources} of {status.configuredSources} configured sources</td><td>{status.coverageNote ?? ASSET_COVERAGE_LABEL[status.coverage]}</td></tr>; })}</tbody></table></div>}
+    </div>
+  </section>;
+}
