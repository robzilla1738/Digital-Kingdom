+import { Icon } from "../../lib/icons.tsx";
+
+export function CoverageWorkspace() {
+  const { ui, dispatch, vm } = useApp(); const [tab, setTab] = useState<"sources" | "assets">("sources");
+  const assetName = (id: string) => vm.data.graph.assets.find((a) => a.id === id)?.name ?? id;
+  const sources = vm.latestData.sources;
